{
  "name": "desktop-assistant",
  "productName": "Sir Pixel Desktop Assistant",
  "version": "0.1.0",
  "description": "A voice-controlled voxel-king desktop companion for Windows, Linux and Android.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "Gaushik2008",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node scripts/serve-web.js",
    "test": "node --test \"test/*.test.mjs\"",
    "icons": "python3 scripts/make_icons.py",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.gaushik.desktopassistant",
    "productName": "Sir Pixel",
    "files": ["electron/**", "src/web/**", "assets/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility", "icon": "assets/icon.png" }
  }
}
