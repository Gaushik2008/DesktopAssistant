{
  "name": "desktop-assistant",
  "productName": "DO.IT Desktop Assistant",
  "version": "0.1.0",
  "description": "A voice-controlled voxel-king desktop companion for Windows, Linux and Android.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "Gaushik2008",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node scripts/serve-web.js",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e:handsfree": "node scripts/e2e-handsfree.cjs",
    "icons": "python3 scripts/make_icons.py",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "smoke": "bash scripts/smoke-electron.sh"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1"
  },
  "build": {
    "appId": "com.gaushik.desktopassistant",
    "productName": "DO.IT",
    "files": [
      "electron/**",
      "src/web/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}
